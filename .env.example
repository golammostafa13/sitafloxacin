# Comma-separated admin emails
ADMIN_EMAILS=
ADMIN_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# Supabase (Project Settings -> API). Leave empty to use the local files instead.
SUPABASE_URL=
# The "service_role" (legacy) or "secret" key. Server only: never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/keepalive (Vercel Cron sends it automatically). openssl rand -hex 32
CRON_SECRET=

# Shared password readers type on the sign-in page (default: Sitamax)
READER_PASSWORD=Sitamax

# Optional. The public address used in QR codes (e.g. https://sagemanual.com).
# When empty, QR codes use the domain the admin page is opened on.
SITE_URL=
